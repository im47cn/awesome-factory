{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "factory-acceptance-manifest/1",
  "type": "object",
  "required": ["schema", "task_id", "request_file", "expected_stages", "receipts"],
  "properties": {
    "schema": {"const": "factory-acceptance-manifest/1"},
    "task_id": {"type": "string", "minLength": 1},
    "request_file": {"type": "string", "minLength": 1},
    "expected_stages": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "receipts": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": true
}
